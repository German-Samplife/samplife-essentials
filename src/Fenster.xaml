<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Samplife Essentials Installer" Width="960" Height="700"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#08090E" Foreground="#F1F3F6" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <!-- Farben der Website (web/src/app/globals.css, dunkles Schema) -->
    <SolidColorBrush x:Key="Flaeche" Color="#13151E"/>
    <SolidColorBrush x:Key="Flaeche2" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Rand" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Gedaempft" Color="#A3A9B6"/>
    <SolidColorBrush x:Key="Leise" Color="#6F7685"/>
    <SolidColorBrush x:Key="Akzent" Color="#007DFF"/>
    <SolidColorBrush x:Key="AkzentHell" Color="#1A8BFF"/>

    <Style x:Key="Hauptknopf" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Akzent}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="26,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource AkzentHell}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Rahmen" Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Foreground" Value="#6F7685"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Nebenknopf" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Flaeche2}"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#6F7685"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Fensterknopf" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Kasten" Width="20" Height="20" CornerRadius="5" Background="Transparent"
                    BorderBrush="#40FFFFFF" BorderThickness="1.5">
              <TextBlock x:Name="Haken" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kasten" Property="Background" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Haken" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Kasten" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Schmale Bildlaufleiste passend zum dunklen Fenster -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#33FFFFFF" CornerRadius="4" Margin="1,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Auswahl der SA-MP-Version als Reihe von Schaltflaechen -->
    <Style x:Key="Wahlknopf" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Rahmen" Background="{StaticResource Flaeche2}" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                    CornerRadius="8" Padding="14,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource AkzentHell}"/>
      <Setter Property="TextDecorations" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="TextDecorations" Value="Underline"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#24FFFFFF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="176"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Kopf: Nacht ueber Los Santos, das Abendlicht scheint schwach durch -->
      <Grid x:Name="Kopf" Grid.Row="0" ClipToBounds="True">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#08090E" Offset="0"/>
            <GradientStop Color="#0D1120" Offset="0.45"/>
            <GradientStop Color="#2B1B2E" Offset="0.78"/>
            <GradientStop Color="#7A4326" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>
        <!-- Skyline von Downtown Los Santos als Silhouette -->
        <Path VerticalAlignment="Bottom" HorizontalAlignment="Left" Fill="#08090E"
              Data="M0,90 L0,62 30,62 30,48 58,48 58,66 80,66 80,40 96,40 96,30 104,30 104,40 120,40 120,70 150,70 150,52 190,52 190,74 215,74 215,34 226,34 226,18 238,18 238,34 250,34 250,60 280,60 280,44 310,44 310,68 340,68 340,26 352,14 364,26 364,56 395,56 395,72 430,72 430,46 470,46 470,22 486,22 486,8 494,8 494,22 510,22 510,58 545,58 545,38 575,38 575,64 600,64 600,30 618,30 618,50 650,50 650,70 685,70 685,42 720,42 720,24 738,24 738,42 752,42 752,62 790,62 790,48 820,48 820,72 850,72 850,36 872,36 872,56 905,56 905,66 935,66 935,50 960,50 960,90 Z"/>
        <!-- einzelne beleuchtete Fenster -->
        <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="960" Height="90" Opacity="0.55">
          <Rectangle Canvas.Left="84" Canvas.Top="48" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="91" Canvas.Top="58" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="220" Canvas.Top="42" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="230" Canvas.Top="28" Width="3" Height="4" Fill="#7DB9FF"/>
          <Rectangle Canvas.Left="243" Canvas.Top="50" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="346" Canvas.Top="36" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="356" Canvas.Top="46" Width="3" Height="4" Fill="#7DB9FF"/>
          <Rectangle Canvas.Left="476" Canvas.Top="30" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="488" Canvas.Top="16" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="500" Canvas.Top="40" Width="3" Height="4" Fill="#7DB9FF"/>
          <Rectangle Canvas.Left="606" Canvas.Top="38" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="726" Canvas.Top="32" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="731" Canvas.Top="50" Width="3" Height="4" Fill="#7DB9FF"/>
          <Rectangle Canvas.Left="856" Canvas.Top="44" Width="3" Height="4" Fill="#FFC27A"/>
          <Rectangle Canvas.Left="864" Canvas.Top="58" Width="3" Height="4" Fill="#FFC27A"/>
        </Canvas>
        <StackPanel Margin="32,30,32,0" VerticalAlignment="Top">
          <TextBlock Text="German Samplife" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
          <TextBlock Text="Samplife Essentials" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0"/>
          <TextBlock x:Name="Untertitel" Foreground="{StaticResource Gedaempft}" FontSize="14" Margin="0,6,0,0"
                     Text="Sprach-Chat und Browser-Oberfläche für dein GTA San Andreas, in einem Schritt eingerichtet."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="KnopfMinimieren" Style="{StaticResource Fensterknopf}" Content="&#xE921;" ToolTip="Minimieren"/>
          <Button x:Name="KnopfSchliessenX" Style="{StaticResource Fensterknopf}" Content="&#xE8BB;" ToolTip="Schließen"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="32,22,32,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Schritt 1: Verzeichnis -->
        <StackPanel Grid.Row="0">
          <TextBlock x:Name="PfadTitel" Text="GTA-Verzeichnis" FontSize="15" FontWeight="SemiBold"/>

          <!-- Automatische Suche: Ergebnis muss der Spieler bestaetigen -->
          <StackPanel x:Name="BereichSuche" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="SucheText" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="138" Margin="0,8,0,0">
              <ItemsControl x:Name="Funde">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="8"
                            Padding="14,9,9,9" Margin="0,0,0,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Pfad}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Gedaempft}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Hauptknopf}" Content="Ja, verwenden" Height="36" FontSize="13"
                                Padding="16,0" Margin="14,0,0,0" Tag="{Binding Pfad}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button x:Name="KnopfAnderer" Style="{StaticResource Nebenknopf}" Content="Anderen Ordner wählen …" Height="36" FontSize="13"
                    HorizontalAlignment="Left" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel x:Name="BereichPfad">
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="8" Height="44">
              <TextBox x:Name="Pfad" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                       CaretBrush="White" VerticalContentAlignment="Center" Padding="12,0" FontSize="14"/>
            </Border>
            <Button x:Name="KnopfDurchsuchen" Grid.Column="1" Style="{StaticResource Nebenknopf}" Content="Durchsuchen …" Margin="10,0,0,0"/>
            <Button x:Name="KnopfSuchen" Grid.Column="2" Style="{StaticResource Nebenknopf}" Content="Automatisch suchen" Margin="10,0,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
            <TextBlock x:Name="PfadSymbol" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock x:Name="PfadStatus" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" MaxWidth="840"/>
          </StackPanel>
          <!-- Nur sichtbar, wenn die SA-MP-Version nicht an der samp.dll erkannt wurde -->
          <StackPanel x:Name="BereichVersion" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="VersionTitel" Text="Mit welcher SA-MP-Version spielst du?" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionPflicht" Foreground="{StaticResource Text}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionHinweis" Foreground="{StaticResource Gedaempft}" FontSize="12" Margin="0,3,0,9" TextWrapping="Wrap"/>
            <StackPanel x:Name="Versionen" Orientation="Horizontal"/>
          </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Schritt 2: Auswahl der Komponenten -->
        <Grid x:Name="BereichAuswahl" Grid.Row="1" Margin="0,22,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Was installiert wird" FontSize="15" FontWeight="SemiBold"/>
          <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <StackPanel x:Name="ListeLaedt" VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="ListeStatus" Foreground="{StaticResource Gedaempft}" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="KnopfErneut" Style="{StaticResource Nebenknopf}" Content="Erneut versuchen" HorizontalAlignment="Center"
                        Margin="0,14,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <ScrollViewer x:Name="ListeRollen" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <ItemsControl x:Name="Liste">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="18,12,18,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Keine Auswahl: alles in der Liste gehoert zum Spielen dazu -->
                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding SymbolFarbe}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Top" Margin="2,4,14,0"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Opacity="{Binding Deckkraft}"/>
                          <TextBlock Text="{Binding Beschreibung}" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                          <TextBlock FontSize="12" Foreground="{StaticResource Leise}" Margin="0,4,0,0">
                            <Run Text="{Binding QuelleVor, Mode=OneWay}"/><Hyperlink NavigateUri="{Binding Quelle}"><Run Text="{Binding Quelle, Mode=OneWay}"/></Hyperlink><Run Text="{Binding QuelleNach, Mode=OneWay}"/>
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="{Binding InfoFarbe}" FontSize="13" Margin="16,2,0,0"
                                   TextAlignment="Right" TextWrapping="Wrap" MaxWidth="210"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Waehrend der Installation: was gerade passiert, mit Quelle -->
        <Grid x:Name="BereichProtokoll" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="Was gerade passiert" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="Prozent" HorizontalAlignment="Right" Foreground="{StaticResource Gedaempft}" FontSize="13" VerticalAlignment="Bottom"/>
          </Grid>
          <Border Grid.Row="1" Height="6" CornerRadius="3" Background="#1AFFFFFF" Margin="0,10,0,0">
            <Border x:Name="Balken" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Akzent}"/>
          </Border>
          <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="ProtokollRollen" VerticalScrollBarVisibility="Auto" Padding="0,8">
              <ItemsControl x:Name="Protokoll">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="16,4,16,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Zeit}" Foreground="{StaticResource Leise}" FontSize="12" FontFamily="Consolas" Margin="0,2,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="{Binding SymbolFarbe}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,3,0,0"/>
                      <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="13" Foreground="{Binding TextFarbe}">
                        <Run Text="{Binding Vor, Mode=OneWay}"/><Hyperlink NavigateUri="{Binding Url}"><Run Text="{Binding Url, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Nach, Mode=OneWay}"/>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- Fuss -->
      <Grid Grid.Row="2" Margin="32,18,32,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Fusszeile" Foreground="{StaticResource Leise}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                   Text="Der Installer schreibt nur in das gewählte Verzeichnis. Dateien, die er ersetzt, sichert er vorher. gta_sa.exe und samp.dll fasst er nicht an."/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="KnopfProtokoll" Style="{StaticResource Nebenknopf}" Content="Protokoll öffnen" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="KnopfAbbrechen" Style="{StaticResource Nebenknopf}" Content="Abbrechen" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="KnopfInstallieren" Style="{StaticResource Hauptknopf}" Content="Installieren" MinWidth="170" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
