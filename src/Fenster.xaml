<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Samplife Launcher" Width="1100" Height="820"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#08090E" Foreground="#F1F3F6" FontFamily="Inter, Segoe UI" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <!-- Farben, Rundungen und Bausteine wie auf der Website (DESIGN.md im Repo samplife). Die Schriften Inter und
         Inter Display bringt der Launcher mit (Schriften.cs); geht das nicht, gilt Segoe UI. -->
    <FontFamily x:Key="Anzeige">Inter Display, Inter, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Flaeche" Color="#06FFFFFF"/>
    <SolidColorBrush x:Key="Flaeche2" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="FlaecheHover" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Rand" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Trenner" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Gedaempft" Color="#A3A9B6"/>
    <SolidColorBrush x:Key="Leise" Color="#6F7685"/>
    <SolidColorBrush x:Key="Akzent" Color="#007DFF"/>
    <SolidColorBrush x:Key="AkzentHell" Color="#1A8BFF"/>
    <SolidColorBrush x:Key="Warnung" Color="#FFB547"/>

    <!-- Hauptknopf: rund, vollblau, eine Hauptaktion pro Ansicht -->
    <Style x:Key="Hauptknopf" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Akzent}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="28,0"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="{TemplateBinding Background}" CornerRadius="24" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource AkzentHell}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Rahmen" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Zweiter Knopf: rund, leise, mit Rand -->
    <Style x:Key="Nebenknopf" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="{TemplateBinding Background}" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="24" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Flaeche}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Rahmen" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Fensterknopf" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource FlaecheHover}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Zeile, die man anklicken kann (Updates): beim Ueberfahren etwas heller -->
    <Style x:Key="Zeilenknopf" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rahmen" Background="Transparent" CornerRadius="16" Padding="12,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Flaeche2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Haken: gewaehlt ist vollblau. Pflicht-Komponenten sind gesperrt (blasser), lassen sich also nicht abwaehlen. -->
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Kasten" Width="22" Height="22" CornerRadius="7" Background="{StaticResource Flaeche2}"
                    BorderBrush="#1FFFFFFF" BorderThickness="1">
              <TextBlock x:Name="Haken" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kasten" Property="Background" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Haken" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Kasten" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Einfacher Link im Text („Was wird geladen?“, „Mehr anzeigen“) -->
    <Style x:Key="Verweis" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource AkzentHell}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Text" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kaestchen mit Beschriftung daneben (Serverpasswort) -->
    <Style x:Key="HakenMitText" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Kasten" Width="18" Height="18" CornerRadius="6" Background="{StaticResource Flaeche2}"
                      BorderBrush="#1FFFFFFF" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="Haken" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kasten" Property="Background" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Haken" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Eingabefeld: im Fokus nur etwas heller, nie blau -->
    <Style x:Key="Feld" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Flaeche2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rand}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Height" Value="48"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="Background" Value="{StaticResource FlaecheHover}"/>
          <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#26FFFFFF" CornerRadius="4" Margin="1,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Auswahl der SA-MP-Version wie die Kategorien der Website: rund, gewaehlt vollblau -->
    <Style x:Key="Wahlknopf" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Rahmen" Background="Transparent" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                    CornerRadius="16" Padding="14,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Akzent}"/>
                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource AkzentHell}"/>
      <Setter Property="TextDecorations" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="TextDecorations" Value="Underline"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{StaticResource Rand}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Kopf: Bild aus dem Spiel ueber die volle Breite (Adressen im Manifest unter "bilder", geladen von der Website),
           oben abgedunkelt fuer Name und Fensterknoepfe, unten laeuft es in den Hintergrund aus. Darauf der Titel. -->
      <Grid x:Name="Kopf" Height="236" ClipToBounds="True" Background="#0B0E15">
        <Image x:Name="Titelbild" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#B808090E" Offset="0"/>
              <GradientStop Color="#2608090E" Offset="0.38"/>
              <GradientStop Color="#9908090E" Offset="0.72"/>
              <GradientStop Color="#FF08090E" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#9908090E" Offset="0"/>
              <GradientStop Color="#0008090E" Offset="0.65"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Grid Margin="28,16,0,0" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource Akzent}">
              <TextBlock Text="S" FontFamily="{DynamicResource Anzeige}" FontSize="19" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="German Samplife" FontFamily="{DynamicResource Anzeige}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="VersionText" Text="Launcher" Foreground="#C2C7D0" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,0,0">
            <Button x:Name="KnopfMinimieren" Style="{StaticResource Fensterknopf}" Content="&#xE921;" ToolTip="Minimieren"/>
            <Button x:Name="KnopfSchliessenX" Style="{StaticResource Fensterknopf}" Content="&#xE8BB;" ToolTip="Schließen"/>
          </StackPanel>
        </Grid>
        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,18">
          <TextBlock x:Name="Titel" Text="Bereit machen" FontFamily="{DynamicResource Anzeige}" FontSize="34" FontWeight="Bold"/>
          <TextBlock x:Name="Untertitel" Foreground="#C2C7D0" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="960" HorizontalAlignment="Left"
                     Text="Der Launcher hält dein GTA auf dem Stand des Servers und verbindet dich direkt."/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="28,8,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Links: oben Name, Passwort und Spielen; nach der Trennlinie alles zur Installation -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Hinweis, z. B. ohne Server-Liste mit dem gesicherten Stand -->
          <Border x:Name="Hinweis" Grid.Row="0" Margin="0,0,0,14" CornerRadius="16" Padding="14,10" Background="{StaticResource Flaeche}"
                  BorderThickness="1" BorderBrush="#4DFFB547" Visibility="Collapsed">
            <TextBlock x:Name="HinweisText" Foreground="{StaticResource Warnung}" FontSize="13" TextWrapping="Wrap"/>
          </Border>

          <!-- Schnellstart: Name, Passwort des Accounts, Spielen -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Dein Name im Spiel" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
            <Border Grid.Row="1" Style="{StaticResource Feld}" Margin="0,6,0,0">
              <TextBox x:Name="Name" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" MaxLength="20"
                       CaretBrush="White" VerticalContentAlignment="Center" Padding="14,0" FontSize="15"/>
            </Border>
            <TextBlock Grid.Column="2" Text="Dein Passwort" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
            <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Feld}" Margin="0,6,0,0"
                    ToolTip="Freiwillig. Mit deinem Passwort meldet dich der Launcher an, und der Login im Spiel entfällt. Es wird nicht gespeichert.">
              <PasswordBox x:Name="Kontopasswort" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                           CaretBrush="White" VerticalContentAlignment="Center" Padding="14,0" FontSize="15"/>
            </Border>
            <Button x:Name="KnopfSpielen" Grid.Column="4" Grid.Row="1" Style="{StaticResource Hauptknopf}" Content="Spielen" MinWidth="170"
                    Margin="0,6,0,0" IsEnabled="False"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ServerpasswortHaken" Style="{StaticResource HakenMitText}" Content="Serverpasswort"/>
                <!-- 4GB-Patch (src/Laa.cs): freiwillig, der Launcher setzt das Bit in der gta_sa.exe nur, wenn es fehlt -->
                <CheckBox x:Name="LaaHaken" Style="{StaticResource HakenMitText}" Content="4GB-Patch" Margin="18,0,0,0"
                          ToolTip="Gegen Abstürze bei hoher Auflösung (1440p, 4K): GTA darf dann 4 statt 2 GB Speicher nutzen. Standardmäßig an. Der Launcher setzt den Patch nur, wenn er in deiner gta_sa.exe fehlt, und sichert sie vorher. Haken raus nimmt ihn wieder zurück."/>
              </StackPanel>
              <TextBlock x:Name="NameStatus" Grid.Column="1" Foreground="{StaticResource Leise}" FontSize="13" Margin="16,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right"
                         Text="Passwort freiwillig: Damit entfällt der Login im Spiel."/>
            </Grid>
            <!-- Nur nach Klick auf „Serverpasswort“ (oder wenn der Server eins verlangt). Wird nicht gespeichert. -->
            <Grid x:Name="BereichPasswort" Grid.Row="3" Grid.ColumnSpan="5" Margin="0,10,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Feld}">
                <PasswordBox x:Name="Passwort" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             CaretBrush="White" VerticalContentAlignment="Center" Padding="14,0" FontSize="15"/>
              </Border>
              <TextBlock Grid.Column="2" Grid.ColumnSpan="3" Foreground="{StaticResource Leise}" FontSize="13" VerticalAlignment="Center"
                         TextWrapping="Wrap" Text="Solange der Server geschlossen ist. Das Passwort bekommst du vom Team."/>
            </Grid>
          </Grid>

          <!-- Trennlinie: darunter alles, was der Launcher fuer das Spiel einrichtet -->
          <Border Grid.Row="2" Height="1" Background="{StaticResource Rand}" Margin="0,20,0,18"/>

          <!-- GTA-Verzeichnis -->
          <StackPanel Grid.Row="3">
            <TextBlock x:Name="PfadTitel" Text="GTA-Verzeichnis" Foreground="{StaticResource Gedaempft}" FontSize="13"/>

            <!-- Automatische Suche: Ergebnis muss der Spieler bestaetigen -->
            <StackPanel x:Name="BereichSuche" Margin="0,6,0,0" Visibility="Collapsed">
              <TextBlock x:Name="SucheText" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="132" Margin="0,8,0,0">
                <ItemsControl x:Name="Funde">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="16"
                              Padding="16,8,8,8" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Pfad}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Gedaempft}" FontSize="13" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="1" Style="{StaticResource Hauptknopf}" Content="Ja, verwenden" Height="38" FontSize="14"
                                  Padding="18,0" Margin="14,0,0,0" Tag="{Binding Pfad}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="KnopfAnderer" Style="{StaticResource Nebenknopf}" Content="Anderen Ordner wählen …" Height="38" FontSize="14"
                      HorizontalAlignment="Left" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel x:Name="BereichPfad">
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Feld}">
                  <TextBox x:Name="Pfad" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                           CaretBrush="White" VerticalContentAlignment="Center" Padding="14,0" FontSize="15"/>
                </Border>
                <Button x:Name="KnopfDurchsuchen" Grid.Column="1" Style="{StaticResource Nebenknopf}" Content="Durchsuchen …" Margin="8,0,0,0"/>
                <Button x:Name="KnopfSuchen" Grid.Column="2" Style="{StaticResource Nebenknopf}" Content="Suchen" Margin="8,0,0,0"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="4,7,0,0">
                <TextBlock x:Name="PfadSymbol" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock x:Name="PfadStatus" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" MaxWidth="640"/>
              </StackPanel>
              <!-- Nur sichtbar, wenn die SA-MP-Version nicht erkannt wurde -->
              <StackPanel x:Name="BereichVersion" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="VersionTitel" Text="Mit welcher SA-MP-Version spielst du?" FontSize="15" FontWeight="Medium"/>
                <TextBlock x:Name="VersionPflicht" Foreground="{StaticResource Text}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="VersionHinweis" Foreground="{StaticResource Gedaempft}" FontSize="13" Margin="0,3,0,9" TextWrapping="Wrap"/>
                <StackPanel x:Name="Versionen" Orientation="Horizontal"/>
              </StackPanel>
              <!-- Fremde ASI Loader und Dateien aus "konflikte" der Liste: nur Hinweis, Ausschalten auf Wunsch -->
              <Border x:Name="BereichFremd" Margin="0,12,0,0" CornerRadius="16" Padding="14,10,10,10" Background="{StaticResource Flaeche}"
                      BorderThickness="1" BorderBrush="#4DFFB547" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="FremdTitel" Foreground="{StaticResource Warnung}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="FremdListe">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Text}" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Button x:Name="KnopfAbschalten" Grid.Column="1" Style="{StaticResource Nebenknopf}" Content="Ausschalten" Height="36" FontSize="13"
                          Padding="16,0" Margin="14,0,0,0" VerticalAlignment="Top"
                          ToolTip="Benennt die Dateien um (Endung .samplife-aus), löscht nichts. „Deinstallieren“ schaltet sie wieder ein."/>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Waehrend Pruefen, Laden und Start: was gerade passiert, die letzten drei Zeilen -->
          <StackPanel x:Name="BereichProtokoll" Grid.Row="4" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid>
              <TextBlock Text="Was gerade passiert" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
              <TextBlock x:Name="Prozent" HorizontalAlignment="Right" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
            </Grid>
            <Border Height="6" CornerRadius="3" Background="{StaticResource Flaeche2}" Margin="0,8,0,0">
              <Border x:Name="Balken" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Akzent}"/>
            </Border>
            <Border Margin="0,10,0,0" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                    CornerRadius="16" Padding="0,8">
              <ItemsControl x:Name="ProtokollKurz">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="18,3,18,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Zeit}" Foreground="{StaticResource Leise}" FontSize="12" Margin="0,2,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="{Binding SymbolFarbe}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,3,0,0"/>
                      <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="13" Foreground="{Binding TextFarbe}">
                        <Run Text="{Binding Vor, Mode=OneWay}"/><Hyperlink NavigateUri="{Binding Url}"><Run Text="{Binding Url, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Nach, Mode=OneWay}"/>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Button x:Name="KnopfMehr" Style="{StaticResource Verweis}" Content="Mehr anzeigen" HorizontalAlignment="Left" Margin="2,8,0,0"/>
          </StackPanel>

          <!-- Was der Launcher laedt: hinter einem Link, damit die Seite ruhig bleibt -->
          <Button x:Name="KnopfDateien" Grid.Row="5" Style="{StaticResource Verweis}" Content="Was wird geladen?" HorizontalAlignment="Left"
                  Margin="2,14,0,0"/>

          <Border x:Name="BereichAuswahl" Grid.Row="6" Margin="0,10,0,0" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}"
                  BorderThickness="1" CornerRadius="24" Visibility="Collapsed">
            <Grid>
                <StackPanel x:Name="ListeLaedt" VerticalAlignment="Center" Margin="24,0">
                  <TextBlock x:Name="ListeStatus" Foreground="{StaticResource Gedaempft}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                  <Button x:Name="KnopfErneut" Style="{StaticResource Nebenknopf}" Content="Erneut versuchen" HorizontalAlignment="Center"
                          Height="40" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer x:Name="ListeRollen" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,6">
                  <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="18,9,18,9">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Gewaehlt, Mode=TwoWay}" IsEnabled="{Binding Waehlbar}" VerticalAlignment="Top"
                                    Margin="0,1,14,0" ToolTip="{Binding HakenHinweis}"/>
                          <StackPanel Grid.Column="1" Opacity="{Binding Deckkraft}">
                            <TextBlock FontSize="15" FontWeight="Medium">
                              <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Art, Mode=OneWay}" Foreground="{StaticResource Leise}" FontSize="13" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Beschreibung}" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Leise}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding QuelleVor, Mode=OneWay}"/><Hyperlink NavigateUri="{Binding Quelle}"><Run Text="{Binding Quelle, Mode=OneWay}"/></Hyperlink><Run Text="{Binding QuelleNach, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="{Binding InfoFarbe}" FontSize="13" Margin="16,2,0,0"
                                     TextAlignment="Right" TextWrapping="Wrap" MaxWidth="190"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Rechts: die neuesten Updates aus der Community -->
        <Border Grid.Column="2" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="24" Padding="10,20,10,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Neu auf dem Server" FontFamily="{DynamicResource Anzeige}" FontSize="20" FontWeight="SemiBold" Margin="12,0,12,8"/>
            <Grid Grid.Row="1">
              <TextBlock x:Name="NeuStatus" Foreground="{StaticResource Leise}" FontSize="13" TextWrapping="Wrap" Margin="12,6,12,0"
                         Text="Lade die neuesten Updates …"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NeuListe">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Zeilenknopf}" Tag="{Binding Url}" Margin="0,0,0,2">
                        <StackPanel>
                          <TextBlock Text="{Binding DatumText}" Foreground="{StaticResource Leise}" FontSize="12"/>
                          <TextBlock Text="{Binding Titel}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding Kurz}" Foreground="{StaticResource Gedaempft}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
            <Button x:Name="KnopfAlleUpdates" Grid.Row="2" Style="{StaticResource Nebenknopf}" Content="Alle Updates in der Community"
                    Height="40" FontSize="14" Margin="2,10,2,0"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Fuss -->
      <Grid Grid.Row="2" Margin="28,18,28,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Fusszeile" Foreground="{StaticResource Leise}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                   Text="Der Launcher schreibt nur ins GTA-Verzeichnis und sichert vorher, was er ersetzt. Deine eigenen Mods fasst er nicht an."/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="KnopfProblem" Style="{StaticResource Nebenknopf}" Content="Problem melden" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"
                  ToolTip="Schickt dem Team die Programme und Logs vom letzten Spiel, wenn Sprach-Chat oder Browser-Oberflächen nicht gehen."/>
          <Button x:Name="KnopfDeinstallieren" Style="{StaticResource Nebenknopf}" Content="Deinstallieren" Height="40" FontSize="14" Margin="8,0,0,0"
                  ToolTip="Entfernt alles, was der Launcher eingerichtet hat, und holt ersetzte Dateien in der Fassung von vorher zurück."/>
          <Button x:Name="KnopfGruendlich" Style="{StaticResource Nebenknopf}" Content="Gründlich prüfen" Height="40" FontSize="14" Margin="8,0,0,0"
                  ToolTip="Rechnet die Prüfsumme jeder Datei nach, statt nur Größe und Änderungszeit zu vergleichen."/>
          <Button x:Name="KnopfProtokoll" Style="{StaticResource Nebenknopf}" Content="Protokoll öffnen" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
          <Button x:Name="KnopfAbbrechen" Style="{StaticResource Nebenknopf}" Content="Abbrechen" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Absturzbericht: SA-MP hat seit dem letzten Start eine neue crashinfo.txt geschrieben (src/Absturzbericht.cs);
           dasselbe Fenster fragt nach einer Diagnose, wenn SampVoice die Grafik von GTA nicht gefunden hat (src/Diagnose.cs) -->
      <Grid x:Name="AbsturzFenster" Grid.RowSpan="3" Background="#A6000000" Visibility="Collapsed">
        <Border Width="620" CornerRadius="30" Background="#0B0E15" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                VerticalAlignment="Center">
          <StackPanel Margin="28,26,28,24">
            <Border x:Name="AbsturzKreis" Width="56" Height="56" CornerRadius="28" Background="#26FFB547" HorizontalAlignment="Left">
              <TextBlock x:Name="AbsturzSymbol" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Warnung}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="AbsturzTitel" Text="Dein Spiel ist abgestürzt" FontFamily="{DynamicResource Anzeige}" FontSize="26"
                       FontWeight="Bold" Margin="0,16,0,0"/>
            <TextBlock x:Name="AbsturzText" Foreground="{StaticResource Gedaempft}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel x:Name="AbsturzEingabe" Margin="0,18,0,0">
              <TextBlock x:Name="AbsturzFrage" Text="Was hast du gerade gemacht? (freiwillig)" Foreground="{StaticResource Gedaempft}" FontSize="13"/>
              <Border Style="{StaticResource Feld}" Height="104" Margin="0,6,0,0">
                <TextBox x:Name="AbsturzKommentar" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         CaretBrush="White" Padding="12,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="1000"
                         VerticalScrollBarVisibility="Auto"/>
              </Border>
              <TextBlock x:Name="AbsturzHinweis" Foreground="{StaticResource Leise}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <!-- Genau den Text zeigen, der gesendet wuerde (Editor), bevor der Spieler auf Senden klickt -->
              <Button x:Name="KnopfAbsturzAnsehen" Style="{StaticResource Verweis}" Content="Ansehen, was gesendet wird" HorizontalAlignment="Left"
                      Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock x:Name="AbsturzStatus" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
              <Button x:Name="KnopfAbsturzNein" Style="{StaticResource Nebenknopf}" Content="Nicht senden" Height="48" FontSize="15"
                      Padding="22,0" Margin="0,0,10,0"/>
              <Button x:Name="KnopfAbsturzSenden" Style="{StaticResource Hauptknopf}" Content="Bericht senden" MinWidth="170"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Andere SA-MP-Version im GTA-Verzeichnis: fragen, ob der Launcher die passende einrichten soll (Ablauf.Planen) -->
      <Grid x:Name="SampFenster" Grid.RowSpan="3" Background="#A6000000" Visibility="Collapsed">
        <Border Width="620" CornerRadius="30" Background="#0B0E15" BorderBrush="{StaticResource Rand}" BorderThickness="1"
                VerticalAlignment="Center">
          <StackPanel Margin="28,26,28,24">
            <Border Width="56" Height="56" CornerRadius="28" Background="#26FFB547" HorizontalAlignment="Left">
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Warnung}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Andere SA-MP-Version gefunden" FontFamily="{DynamicResource Anzeige}" FontSize="26"
                       FontWeight="Bold" Margin="0,16,0,0"/>
            <TextBlock x:Name="SampText" Foreground="{StaticResource Gedaempft}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="KnopfSampAbbrechen" Style="{StaticResource Nebenknopf}" Content="Abbrechen" Height="48" FontSize="15"
                      Padding="22,0" Margin="0,0,10,0"/>
              <Button x:Name="KnopfSampEinrichten" Style="{StaticResource Hauptknopf}" Content="Einrichten" MinWidth="170"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Alles, was gerade passiert, in einem Fenster ueber dem Launcher („Mehr anzeigen“) -->
      <Grid x:Name="ProtokollFenster" Grid.RowSpan="3" Background="#A6000000" Visibility="Collapsed">
        <Border Width="780" Height="540" CornerRadius="30" Background="#0B0E15" BorderBrush="{StaticResource Rand}" BorderThickness="1">
          <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Was gerade passiert" FontFamily="{DynamicResource Anzeige}" FontSize="22" FontWeight="SemiBold"/>
            <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="16">
              <ScrollViewer x:Name="ProtokollRollen" VerticalScrollBarVisibility="Auto" Padding="0,10">
                <ItemsControl x:Name="Protokoll">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="18,3,18,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="46"/>
                          <ColumnDefinition Width="22"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Zeit}" Foreground="{StaticResource Leise}" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="{Binding SymbolFarbe}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="13" Foreground="{Binding TextFarbe}">
                          <Run Text="{Binding Vor, Mode=OneWay}"/><Hyperlink NavigateUri="{Binding Url}"><Run Text="{Binding Url, Mode=OneWay}"/></Hyperlink><Run Text="{Binding Nach, Mode=OneWay}"/>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <Button x:Name="KnopfFensterZu" Grid.Row="2" Style="{StaticResource Nebenknopf}" Content="Schließen" Height="40" FontSize="14"
                    HorizontalAlignment="Right" Margin="0,16,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
