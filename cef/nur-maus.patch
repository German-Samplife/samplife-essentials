+
+/// Cursor after a change of the input mode. NONE and FULL behave exactly as
+/// before (`show_cursor`), MOUSE_ONLY uses SA:MP cursor mode 3.
+fn apply_cursor(app: &mut App, mode: InputMode) {
+    let menu_active = CMenuManager::is_menu_active();
+
+    if mode == InputMode::MouseOnly && !menu_active {
+        if !samp_ui_active() {
+            apply_mouse_only_cursor(app);
+        }
+    } else {
+        let show = mode != InputMode::None && !menu_active;
+
+        // FULL after MOUSE_ONLY (text field focused): lock the controls again
+        let from_mouse_only = app.cursor_mode == inputs::CURSOR_LOCK_CAM;
+
+        client_api::samp::inputs::show_cursor(show);
+
+        if show && from_mouse_only {
+            inputs::process_input_enabling();
+        }
+
+        if !inputs::Input::is_active() {
+            app.cursor_mode = if show {
+                inputs::CURSOR_LOCK_CAM_AND_CONTROL
+            } else {
+                inputs::CURSOR_NONE
+            };
+        }
+    }
+
+    update_mouse_only_lock(app);
+}
+
+/// SA:MP cursor mode 3: cursor visible, camera locked, keyboard controls on.
+/// Set every frame like `show_cursor(true)` for FULL, because SA:MP resets it.
+fn apply_mouse_only_cursor(app: &mut App) {
+    inputs::set_cursor_mode(inputs::CURSOR_LOCK_CAM, false);
+
+    if app.cursor_mode != inputs::CURSOR_LOCK_CAM && !inputs::Input::is_active() {
+        inputs::process_input_enabling();
+        app.cursor_mode = inputs::CURSOR_LOCK_CAM;
+    }
+}
