index 0000000..1b38f1e
--- /dev/null
+++ b/client/src/mouse_only.rs
@@ -0,0 +1,104 @@
+//! Game side of the mouse-only input mode (`CEF_INPUT_MOUSE_ONLY`).
+//!
+//! SA:MP cursor mode 3 shows the cursor and locks the camera, but GTA reads
+//! mouse buttons and the wheel through DirectInput, not through window
+//! messages. To make sure a click on a page never fires a weapon, aims or
+//! switches weapons, the hook below clears GTA's mouse state right after the
+//! game has read it, as long as a mouse-only browser holds the input.
+//!
+//! Switch: `"mouse_only_block_game_mouse": false` in `cef/config.json`
+//! disables the hook (default: enabled).
+
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use retour::GenericDetour;
+
+use crate::static_cell::StaticCell;
+
+// GTA San Andreas 1.0 US. Source: gta-reversed (github.com/gta-reversed/gta-reversed)
+// - source/game_sa/Pad.cpp: `RH_ScopedInstall(UpdateMouse, 0x53F3C0, ...)`, member
+//   function `void CPad::UpdateMouse()`; it ends with
+//   `OldMouseControllerState = std::exchange(NewMouseControllerState, TempMouseControllerState)`
+//   and is called by `CPad::UpdatePads()` (0x541DD0) before `AffectPadFromMouse()`.
+// - source/game_sa/Pad.h: `NewMouseControllerState = StaticRef<CMouseControllerState>(0xB73418)`
+// - source/game_sa/MouseControllerState.h: LMB, RMB, MMB, wheel up/down, X1, X2,
+//   wheel delta, movement; `VALIDATE_SIZE(CMouseControllerState, 0x14)`
+const CPAD_UPDATE_MOUSE: usize = 0x53F3C0;
+const CPAD_NEW_MOUSE_CONTROLLER_STATE: usize = 0xB73418;
+const MOUSE_CONTROLLER_STATE_SIZE: usize = 0x14;
+
+type UpdateMouseFn = extern "thiscall" fn(*mut c_void);
+
+static UPDATE_MOUSE_HOOK: StaticCell<GenericDetour<UpdateMouseFn>> = StaticCell::new();
+
+// A mouse-only browser holds the input right now (no SA:MP dialog, chat
+// input or pause menu in between, game window active).
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+pub fn install() {
+    if !crate::block_game_mouse() {
+        tracing::info!("mouse-only: game mouse lock disabled in config.json");
+        return;
+    }
+
+    let hook = unsafe {
+        let original: UpdateMouseFn = std::mem::transmute(CPAD_UPDATE_MOUSE);
+
+        match GenericDetour::new(original, update_mouse) {
+            Ok(hook) => hook,
+            Err(error) => {
+                tracing::warn!(%error, "mouse-only: cannot create CPad::UpdateMouse hook");
+                return;
+            }
+        }
+    };
+
+    let hook = unsafe { UPDATE_MOUSE_HOOK.set(hook) };
+
+    if let Err(error) = unsafe { hook.enable() } {
+        tracing::warn!(%error, "mouse-only: cannot enable CPad::UpdateMouse hook");
+        unsafe {
+            UPDATE_MOUSE_HOOK.take();
+        }
+        return;
+    }
+
+    tracing::debug!("mouse-only: CPad::UpdateMouse hook installed");
+}
+
+pub fn uninstall() {
+    ACTIVE.store(false, Ordering::SeqCst);
+
+    unsafe {
+        if let Some(hook) = UPDATE_MOUSE_HOOK.get_mut() {
+            let _ = hook.disable();
+        }
+    }
+}
+
+#[inline]
+pub fn set_active(active: bool) {
+    ACTIVE.store(active, Ordering::SeqCst);
+}
+
+#[inline]
+pub fn is_active() -> bool {
+    ACTIVE.load(Ordering::SeqCst)
+}
+
+extern "thiscall" fn update_mouse(pad: *mut c_void) {
+    if let Some(hook) = unsafe { UPDATE_MOUSE_HOOK.get_mut() } {
+        hook.call(pad);
+    }
+
+    if ACTIVE.load(Ordering::SeqCst) {
+        unsafe {
+            std::ptr::write_bytes(
+                CPAD_NEW_MOUSE_CONTROLLER_STATE as *mut u8,
+                0,
+                MOUSE_CONTROLLER_STATE_SIZE,
+            );
+        }
+    }
+}
