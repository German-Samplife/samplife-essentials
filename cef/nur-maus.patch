+use cef_sys::cef_domnode_t;
+
+/// Snapshot of a DOM node in the renderer process.
+///
+/// CEF: DOM objects are only valid for the scope of the callback that
+/// provides them, so handlers only get a reference and must not keep it.
+pub struct DomNode {
+    raw: *mut cef_domnode_t,
+}
+
+impl DomNode {
+    pub(crate) fn from_raw_borrowed(raw: *mut cef_domnode_t) -> Option<DomNode> {
+        if raw.is_null() {
+            None
+        } else {
+            Some(DomNode { raw })
+        }
+    }
+
+    /// True for editable nodes: text inputs, textareas and contenteditable.
+    pub fn is_editable(&self) -> bool {
+        unsafe {
+            (*self.raw)
+                .is_editable
+                .map(|is_editable| is_editable(self.raw) != 0)
+                .unwrap_or(false)
+        }
+    }
+}
