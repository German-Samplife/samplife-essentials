+/// Input mode of a browser (`CEF_INPUT_*` on the server).
+#[derive(Debug, Clone, Copy, Hash, Eq, PartialEq)]
+pub enum InputMode {
+    /// No input (`focused = false`).
+    None = 0,
+    /// Mouse and keyboard go to the browser (`focused = true`).
+    Full = 1,
+    /// Mouse goes to the browser, keyboard stays with the game.
+    MouseOnly = 2,
+}
+
+impl InputMode {
+    pub fn from_raw(mode: u32) -> Option<InputMode> {
