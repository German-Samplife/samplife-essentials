+    /// Gives the copy of the last frame back while the browser is hidden.
+    /// The next paint after showing it again is a full one (new buffer size).
+    fn release_frame(&mut self) {
+        self.view_buffer = Vec::new();
+        self.width = 0;
+        self.height = 0;
+        self.rects.rects = Vec::new();
+        self.rects.count = 0;
+        self.changed = false;
+    }
+
+    /// After a new texture: upload the whole frame we still have, the texture
+    /// starts out empty. Without a matching frame the next paint fills it.
+    fn upload_all(&mut self, width: usize, height: usize) {
+        let has_frame = self.width == width
+            && self.height == height
+            && width
+                .checked_mul(height)
+                .and_then(|pixels| pixels.checked_mul(4))
+                .is_some_and(|len| len > 0 && self.view_buffer.len() >= len);
+
+        if has_frame {
+            self.rects.rects.clear();
+            self.rects.rects.push(cef_rect_t {
+                x: 0,
+                y: 0,
+                width: width as i32,
+                height: height as i32,
+            });
+            self.rects.count = 1;
+            self.changed = true;
+        }
+
+        if self.popup_show && !self.popup_buffer.is_empty() {
+            self.popup_changed = true;
+        }
+    }
 }
 
