+            // Mouse buttons 4 and 5 (side buttons back/forward): CEF has no mouse
+            // event for them, so the pages get them as keys with the Windows key
+            // codes VK_XBUTTON1 (5) and VK_XBUTTON2 (6) and handle them like any
+            // other key (keyCode 5/6). They go where keys go: the focused browser,
+            // or browsers that always listen to keys. The game still gets the
+            // message. Key-up is sent even while the chat or a dialog is open,
+            // so a held button can't get stuck in a page.
+            WM_XBUTTONDOWN | WM_XBUTTONDBLCLK | WM_XBUTTONUP => {
+                let code = match ((wparam >> 16) & 0xFFFF) as u16 {
+                    XBUTTON1 => VK_XBUTTON1,
+                    XBUTTON2 => VK_XBUTTON2,
+                    _ => return false,
+                };
+
+                let up = msg == WM_XBUTTONUP;
+                let input_active = inputs::Input::is_active()
+                    || inputs::Dialog::is_input_focused()
+                    || CMenuManager::is_menu_active();
+
+                if up || !input_active {
+                    let mut event: cef_key_event_t = unsafe { std::mem::zeroed() };
+
+                    event.size = std::mem::size_of::<cef_key_event_t>();
+                    event.windows_key_code = code;
+                    event.type_ = if up {
+                        cef_key_event_type_t::KEYEVENT_KEYUP
+                    } else {
+                        cef_key_event_type_t::KEYEVENT_RAWKEYDOWN
+                    };
+
+                    manager.send_keyboard_event(event);
+                }
+            }
+
