+/// Arguments of a server event as one string, joined by spaces like `cef.emit` arguments
+/// arrive on the server (browser/client.rs, "emit_event").
+fn list_arguments(list: &List) -> String {
+    (0..list.len())
+        .map(|idx| match list.get_type(idx) {
+            ValueType::String => list.string(idx).to_string(),
+            ValueType::Bool => (if list.bool(idx) { 1 } else { 0 }).to_string(),
+            ValueType::Double => list.double(idx).to_string(),
+            ValueType::Integer => list.integer(idx).to_string(),
+            _ => "CEF_NULL".to_string(),
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
