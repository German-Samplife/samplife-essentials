+/// True if at least one plugin wants events from the server.
+pub fn wants_server_events() -> bool {
+    ExternalManager::get()
+        .is_some_and(|ext| ext.plugins.iter().any(|plugin| plugin.server_event.is_some()))
+}
+
+/// Hands an event from the server to the plugins. Returns true if one of them handled it
+/// with `EXTERNAL_BREAK`; the browsers don't get it then.
+pub fn server_event(event: &str, arguments: &str) -> bool {
+    let Some(ext) = ExternalManager::get() else {
+        return false;
+    };
+
+    let (Ok(event), Ok(arguments)) = (CString::new(event), CString::new(arguments)) else {
+        return false;
+    };
+
+    for plugin in &ext.plugins {
+        if let Some(func) = plugin.server_event.as_ref()
+            && func(event.as_ptr(), arguments.as_ptr()) == EXTERNAL_BREAK
+        {
+            return true;
+        }
+    }
+
+    false
+}
