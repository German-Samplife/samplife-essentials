+unsafe extern "C" fn cef_emit_server_event(event: *const c_char, arguments: *const c_char) {
+    if event.is_null() {
+        return;
+    }
+
+    let event = unsafe { CStr::from_ptr(event) }.to_string_lossy().into_owned();
+    let arguments = if arguments.is_null() {
+        String::new()
+    } else {
+        unsafe { CStr::from_ptr(arguments) }.to_string_lossy().into_owned()
+    };
+
+    if let Some(external) = ExternalManager::get() {
+        let _ = external.event_tx.send(Event::EmitEventOnServer(event, arguments));
+    }
+}
