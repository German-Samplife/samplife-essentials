+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn max_fps_limit_keeps_sensible_values() {
+        assert_eq!(max_fps_limit(0), 0);
+        assert_eq!(max_fps_limit(-5), 0);
+        assert_eq!(max_fps_limit(30), 30);
+        assert_eq!(max_fps_limit(1000), 240);
+    }
+
+    #[test]
+    fn capped_frame_rate_lowers_only_with_a_limit() {
+        assert_eq!(capped_frame_rate(144, 0), 144);
+        assert_eq!(capped_frame_rate(144, 30), 30);
+        assert_eq!(capped_frame_rate(20, 30), 20);
