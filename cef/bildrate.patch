+/// Limit from cef.set_max_fps: 0 or less = none, otherwise 1 to 240 frames per second.
+fn max_fps_limit(fps: i32) -> i32 {
+    if fps <= 0 { 0 } else { fps.min(240) }
+}
+
+fn capped_frame_rate(game_fps: i32, max_fps: i32) -> i32 {
+    if max_fps > 0 {
+        game_fps.min(max_fps)
+    } else {
+        game_fps
+    }
+}
